# Required in production
SESSION_SECRET=replace-with-a-long-random-secret

# Admin access
# Put the real admin emails here. These accounts become admins after signup/login.
ADMIN_EMAILS=thestickboy@example.com,itzkuroyt@example.com

# Optional but recommended if your live domain differs from config.js.
# Add every domain that may POST to the API.
ALLOWED_ORIGINS=https://minestore.org,https://icon-builds.vercel.app

# Email verification through Resend.
# Without these, dev can create verification codes, but production email sending is skipped/broken.
RESEND_API_KEY=
RESEND_FROM_EMAIL=IconBuilds <verify@minestore.org>

# Google OAuth login.
# Google redirect URI should be: https://icon-builds.vercel.app/api/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe paid checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: override the Stripe Managed Payments tax code for all paid resources.
# Defaults live in config.js. Ask Stripe or a tax professional before changing this.
STRIPE_PRODUCT_TAX_CODE=
# Optional: override the Stripe tax code used for optional free-resource donations.
STRIPE_DONATION_TAX_CODE=
# Optional fallback only if you intentionally disable Managed Payments for checkout sessions.
# Prefer setting a valid product tax code instead.
# STRIPE_MANAGED_PAYMENTS_ENABLED=false

# GitHub database storage for Vercel.
# The token should only have contents read/write permission for this repo.
# Published resource edits also update sitemap.xml and generated /resources/<slug>/ pages.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
GITHUB_BRANCH=main
GITHUB_DB_PATH=data/iconbuilds-db.json
GITHUB_DB_BACKUP_PATH=data/iconbuilds-db.backup.json
GITHUB_SITEMAP_PATH=sitemap.xml
GITHUB_UPLOADS_PATH=uploads/images

# Local-only overrides. Do not use these for Vercel unless you know why.
# ICONBUILDS_DB_PATH=
# ICONBUILDS_DB_BACKUP_PATH=
